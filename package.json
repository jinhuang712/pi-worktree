{
  "name": "pi-worktree",
  "version": "0.1.0",
  "description": "Native Pi worktree flow: /worktree isolates changes into a new git worktree, /land merges back with conflict handling. Clean workspaces are encouraged to isolate proactively.",
  "private": false,
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "pi", "git", "worktree"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinhuang712/pi-worktree.git"
  },
  "bugs": {
    "url": "https://github.com/jinhuang712/pi-worktree/issues"
  },
  "homepage": "https://github.com/jinhuang712/pi-worktree#readme",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "26.2.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
